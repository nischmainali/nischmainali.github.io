{{- /* One page per selected work, each the first page of a reprint, plus the
      Papers register. The record itself stays in data/selected_works.toml;
      a work without an id, or with a repeated one, stops the build. */ -}}
{{- $works := hugo.Data.selected_works.works -}}
{{- if not $works }}{{ errorf "data/selected_works.toml contains no works" }}{{ end -}}
{{- $seen := dict -}}
{{- range $works -}}
  {{- if not .id }}{{ errorf "A selected work is missing its id" }}{{ end -}}
  {{- if isset $seen .id }}{{ errorf "Selected work id %q is repeated" .id }}{{ end -}}
  {{- $seen = merge $seen (dict .id true) -}}
{{- end -}}
{{- $.AddPage (dict
    "kind" "section"
    "path" "."
    "title" "Selected works"
    "params" (dict "page_class" "index-page")) -}}
{{- range $works -}}
  {{- $.AddPage (dict
      "kind" "page"
      "path" .id
      "title" .title
      "date" (printf "%d-01-01" (int .year))
      "content" (dict "mediaType" "text/markdown" "value" "")
      "params" (dict "work_id" .id "page_class" "index-page index-paper")) -}}
{{- end -}}
